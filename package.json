    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
